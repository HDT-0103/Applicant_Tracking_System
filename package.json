{
  "name": "smartats-frontend",
  "version": "4.2.1",
  "private": true,
  "scripts": {
    "dev": "env-cmd -f .env --silent next dev src/frontend",
    "build": "env-cmd -f .env --silent next build src/frontend",
    "start": "env-cmd -f .env --silent next start src/frontend",
    "lint": "next lint src/frontend",
    "typecheck": "tsc --noEmit -p src/frontend/tsconfig.json",
    "backend:dev": "env-cmd -f .env python -m uvicorn apps.main:app --reload --host 0.0.0.0 --port 8000 --app-dir src/backend",
    "backend:start": "env-cmd -f .env python -m uvicorn apps.main:app --host 0.0.0.0 --port 8000 --app-dir src/backend",
    "backend:dev:win": "env-cmd -f .env python src/backend/run.py",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:py": "pytest",
    "test:all": "npm run test && npm run test:py"
  },
  "dependencies": {
    "@react-oauth/google": "^0.13.5",
    "@supabase/supabase-js": "^2.110.7",
    "lucide-react": "^0.468.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.17.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.0",
    "env-cmd": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.20",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
