# Application
APP_NAME=SmartATS
APP_ENV=development
# Múi giờ dùng cho MỌI mốc thời gian gửi ra ngoài (email mời phỏng vấn, thông
# báo Slack). Email và Slack đọc chung biến này — đổi một nơi là cả hai theo.
APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# PostgreSQL / pgvector
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=smartats
POSTGRES_USER=smartats
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+psycopg://smartats:change_me@localhost:5432/smartats

# Redis / background coordination
REDIS_URL=redis://localhost:6379/0

# LLM providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GROQ_API_KEY=
HF_API_KEY=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# MCP host
MCP_HOST=localhost
MCP_PORT=8765
MCP_TOOL_REGISTRY_PATH=src/backend/modules/mcp-host/tools

# Resume ingestion
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25
ALLOWED_RESUME_EXTENSIONS=pdf,docx

# External integrations
AZURE_SERVICE_BUS_CONNECTION_STRING=
AZURE_SERVICE_BUS_QUEUE_NAME=smartats-events
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/schedule
GOOGLE_CALENDAR_ID=primary

# Email (SMTP) — used to send interview notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_account@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM_EMAIL=your_account@gmail.com

# Thông báo Slack khi chốt lịch phỏng vấn. Bỏ trống thì lịch vẫn đặt được và
# email vẫn gửi — Slack là kênh phụ, `confirmed_slots.slack_notified` ghi lại
# là chưa gửi. Cách lấy webhook: xem docs/NOTIFICATIONS_SETUP.md
SLACK_WEBHOOK_URL=

# Security
JWT_SECRET=change_me_in_local_env_use_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ADMIN_EMAILS=
RECRUITER_EMAIL_DOMAINS=

# External APIs for Enrichment
GITHUB_API_TOKEN=
GEMINI_API_KEY=
APIFY_API_TOKEN=#API để cào linkedln
AZURE_STORAGE_CONNECTION_STRING="chuỗi_key_1_hoặc_2_bạn_vừa_copy"
AZURE_SERVICE_BUS_CONNECTION_STRING="chuỗi_root_manage_bạn_vừa_copy"

# SUPABASE APIs
# Ba biến dưới đây BẮT BUỘC — thiếu một cái là backend không khởi động được
# (Settings đọc env ngay lúc import, xem modules/shared/infrastructure/config.py).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Khoá service_role, bỏ qua RLS. Chỉ dùng ở backend, KHÔNG bao giờ để lộ ra
# frontend. Tên phải đúng là SUPABASE_SERVICE_ROLE_KEY — từng có giai đoạn
# .env ghi SUPABASE_SERVICE_KEY khiến app chết ngay khi khởi động.
SUPABASE_SERVICE_ROLE_KEY=
